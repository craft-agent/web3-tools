{
  "name": "web3-tools",
  "version": "0.0.0",
  "description": "Web3 tools for coding agents: EVM and Solana reads, wallets and sends, and Hyperliquid.",
  "author": {
    "name": "craftsamo",
    "url": "https://github.com/craft-agent"
  },
  "homepage": "https://github.com/craft-agent/web3-tools#readme",
  "repository": "https://github.com/craft-agent/web3-tools",
  "license": "LicenseRef-AGPL-3.0-Commons-Clause",
  "skills": "./skills",
  "mcpServers": {
    "web3-tools": {
      "command": "node",
      "args": ["dist/mcp.js"],
      "cwd": ".",
      "default_tools_approval_mode": "writes",
      "env_vars": [
        "WEB3_TOOLS_TOOLSETS",
        "WEB3_TOOLS_READ_ONLY",
        "WEB3_TOOLS_TOOLS",
        "WEB3_TOOLS_EXCLUDE_TOOLS",
        "WEB3_TOOLS_CONFIRM",
        "WEB3_TOOLS_UNATTENDED",
        "WEB3_TOOLS_GRANTS_DIR",
        "WEB3_TOOLS_GRANT_KEY",
        "ALCHEMY_API_KEY",
        "HELIUS_API_KEY"
      ]
    }
  }
}
